# Copy this file to backend/.env and fill in the values. NEVER commit backend/.env.

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- Google OAuth client (Google Cloud Console > APIs & Services > Credentials) ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must match an "Authorized redirect URI" on the OAuth client EXACTLY.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- App ---
DATABASE_URL=sqlite:///./smart_email.db
FRONTEND_ORIGIN=http://localhost:5173

# Signs the session cookie. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me
# Encrypts stored OAuth tokens. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me
# Set to true when serving over HTTPS.
SESSION_HTTPS_ONLY=false

# Timezone used to interpret explicit deadlines like "5 November 2026 at 5 PM" (IANA name).
USER_TIMEZONE=Asia/Kolkata
# false = tasks are created only when you click "Create Task" (recommended).
# true  = the agent creates suggested tasks automatically (still de-duplicated).
AUTO_CREATE_TASKS=false
